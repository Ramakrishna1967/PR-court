# ── Core ─────────────────────────────────────────────────────────────────────

# Set to true to run without model API keys or Docker
MOCK_MODE=true

# Set to true to use local mock data in the frontend (no backend calls)
VITE_USE_MOCK=false

# ── Database ───────────────────────────────────────────────────────────────────
# (auto-configured in docker-compose; only needed for local dev outside Docker)
DATABASE_URL=postgresql+asyncpg://prcourt:prcourt@localhost:5432/prcourt
DATABASE_URL_SYNC=postgresql+psycopg2://prcourt:prcourt@localhost:5432/prcourt

# ── LLM API Keys ──────────────────────────────────────────────────────────────
# At least one is required when MOCK_MODE=false
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── GitHub App ─────────────────────────────────────────────────────────────────
# Register at https://github.com/settings/apps
# Required for webhook PR comment posting (optional)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── Per-agent Model Override (optional) ────────────────────────────────────────
# Format: PRCOURT_MODEL_<ROLE>=<model_name>
# PRCOURT_MODEL_INTAKE=gemini-1.5-flash
# PRCOURT_MODEL_JUDGE=gemini-1.5-pro
# PRCOURT_MODEL_JUROR_2=claude-3-5-sonnet-20241022

# ── Observability (optional) ──────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=pr-court

# ── Sandbox Limits (optional override) ────────────────────────────────────────
# PRCOURT_SANDBOX_MEMORY_MB=512
# PRCOURT_SANDBOX_COMMAND_TIMEOUT_S=30
# PRCOURT_SANDBOX_PIDS_LIMIT=64

# ── Budget Cap ────────────────────────────────────────────────────────────────
# Trial is aborted with INCONCLUSIVE verdict if this is exceeded
# TRIAL_BUDGET_USD=2.0

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# Legacy (from original project)
GEMINI_API_KEY=your_gemini_api_key_here
APP_URL=http://localhost:3000
